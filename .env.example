# ==========================================
# AI Recruiting Platform Environment Config
# ==========================================

# ------------------------------------------
# Application Settings
# ------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=True

# ------------------------------------------
# Backend API (FastAPI)
# ------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
API_V1_STR=/api/v1
SECRET_KEY=your_super_secret_jwt_key_here
ACCESS_TOKEN_EXPIRE_MINUTES=11520

# ------------------------------------------
# Frontend (Next.js)
# ------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
PORT=3000

# ------------------------------------------
# Database (PostgreSQL)
# ------------------------------------------
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_recruiting
POSTGRES_PORT=5432
# SQLALCHEMY_DATABASE_URI=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_SERVER}:${POSTGRES_PORT}/${POSTGRES_DB}

# ------------------------------------------
# Vector Database (e.g. Pinecone/Qdrant)
# ------------------------------------------
VECTOR_DB_PROVIDER=local
# PINECONE_API_KEY=your_pinecone_key
# PINECONE_ENVIRONMENT=us-west1-gcp
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=your_qdrant_key

# ------------------------------------------
# AI Models / Providers
# ------------------------------------------
OPENAI_API_KEY=sk-your_openai_api_key_here
AI_EXTRACTION_MODEL=gpt-4o-mini
AI_EMBEDDING_MODEL=text-embedding-3-small
# ANTHROPIC_API_KEY=sk-ant-your_anthropic_api_key_here
# MISTRAL_API_KEY=your_mistral_api_key

# ------------------------------------------
# MCP (Model Context Protocol) & Tools
# ------------------------------------------
ENABLE_MCP=True
# BROWSER_BASE_API_KEY=your_browser_base_key
# SERPAPI_API_KEY=your_serpapi_key

# ------------------------------------------
# Observability (OpenTelemetry / LangSmith)
# ------------------------------------------
LANGCHAIN_TRACING_V2=false
# LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
# LANGCHAIN_API_KEY=your_langsmith_api_key
# LANGCHAIN_PROJECT=ai_recruiting_platform

# ------------------------------------------
# Background Jobs (Redis / Celery)
# ------------------------------------------
REDIS_URL=redis://localhost:6379/0
